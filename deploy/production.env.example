# Dokploy stack environment. Names of Docker secrets only: no secret value belongs here.
PUBLIC_HOST=hashifi.hashikome.com
API_IMAGE=
WEB_IMAGE=
APP_REPLICAS=0
RELEASE_ATTEMPT=
INGRESS_NETWORK=
BACKEND_NETWORK=
HTTPS_ENTRYPOINT=
TLS_RESOLVER=
TRUSTED_PROXIES=
EMAIL_FROM=HashiFi <no-reply@notify.hashikome.com>
R2_ENDPOINT=
R2_BUCKET=hashifi
# The API's address on the management tunnel; see ADR-0006.
ROUTER_MANAGEMENT_URL=
DATABASE_URL_SECRET=hashifi_database_url
MIGRATION_DATABASE_URL_SECRET=hashifi_migration_database_url
ENCRYPTION_KEY_SECRET=hashifi_encryption_key
AUTH_SECRET=hashifi_auth_secret
RESEND_KEY_SECRET=hashifi_resend_key
R2_ACCESS_KEY_ID_SECRET=hashifi_r2_access_key_id
R2_SECRET_ACCESS_KEY_SECRET=hashifi_r2_secret_access_key
