{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!ref",
      "!.agents",
      "!apps/api/src/generated/prisma",
      "!**/*.md",
      "!apps/api/mikrotik-files"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off",
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "domains": {
          "next": "recommended",
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/routes/**",
        "apps/api/src/middleware/**",
        "apps/api/src/server.ts",
        "apps/api/src/db/**",
        "apps/api/drizzle.config.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn",
            "noImplicitAnyLet": "warn",
            "noControlCharactersInRegex": "warn",
            "noGlobalIsNan": "warn",
            "noAssignInExpressions": "warn"
          },
          "style": {
            "noNonNullAssertion": "warn"
          },
          "correctness": {
            "noInnerDeclarations": "warn",
            "noUnusedVariables": "warn"
          },
          "complexity": {
            "noImportantStyles": "warn"
          }
        }
      }
    }
  ]
}
