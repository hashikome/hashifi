{
  // `tsconfig.json` sets `noEmit: true` because it is the typecheck config — `pnpm typecheck` and
  // every editor read it. `pnpm build` used to run bare `tsc` against it and therefore emitted
  // nothing at all, leaving `pnpm start` (`node dist/src/server.js`) with no dist/ to run.
  //
  // This config is the one that actually produces output, and it excludes the test files so they
  // never land in a production build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false
  },
  "exclude": ["**/*.test.ts", "dist"]
}
