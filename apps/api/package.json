{
  "name": "@hashifi/api",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/entrypoint.ts",
    "start": "bun src/entrypoint.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns='test/integration/**'",
    "db:generate": "bun --bun prisma generate",
    "db:validate": "bun --bun prisma validate",
    "db:format": "bun --bun prisma format",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:deploy": "bun --bun prisma migrate deploy",
    "db:reset": "bun --bun prisma migrate reset",
    "db:seed": "bun --bun prisma db seed",
    "db:studio": "bun --bun prisma studio",
    "staff:add": "bun src/staff/add-staff.cli.ts",
    "postinstall": "bun --bun prisma generate",
    "test:integration": "bun test test/integration"
  },
  "dependencies": {
    "@hashifi/types": "workspace:*",
    "@logtape/logtape": "2.4.2",
    "@logtape/sentry": "2.4.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/bun": "11.10.0",
    "better-auth": "1.7.14",
    "express": "5.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "routeros": "1.6.12",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/bun": "1.4.4",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  }
}
