  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "seed": "bun src/db/seed.ts",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:migrate:mark": "bun src/db/mark-migration-applied.ts",
    "db:studio": "bunx --bun drizzle-kit studio"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "nodemailer": "10.2.1",
    "routeros": "1.6.12",
    "sharp": "0.35.5",
    "ua-parser-js": "2.0.10",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/ua-parser-js": "0.7.39",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
