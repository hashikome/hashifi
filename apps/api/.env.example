# Server
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL=mysql://user:password@localhost:3306/wifi_billing

# Session
SESSION_COOKIE_NAME=wifi_admin_session
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# CORS
FRONTEND_ORIGIN=http://localhost:4000
APP_URL=http://localhost:8080

# SMTP (email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# Snippe (payment gateway)
SNIPPE_API_KEY=your-snippe-api-key
SNIPPE_WEBHOOK_SECRET=your-snippe-webhook-secret

# MikroTik
MIKROTIK_API_PORT=8728
MIKROTIK_CONNECT_TIMEOUT=10

# Optional. How routers reach this server when they fetch the portal pages.
# Normally discovered automatically by finding the local interface on the router's
# subnet — set this only when that discovery cannot work.
# BACKEND_LAN_URL=http://192.168.0.15:8080
