# Every key the API reads. Copy to apps/api/.env for local development; production values come
# from Docker secrets (<NAME>_FILE) or a private env file (docs/SECURITY.md, Credentials).

PORT=8080
NODE_ENV=development

# PostgreSQL (compose.yml at the repository root). Production: DATABASE_URL_FILE.
DATABASE_URL=postgresql://hashifi:hashifi@127.0.0.1:5437/hashifi

# 32-byte hex key for router credentials and tunnel keys at rest (AES-256-GCM).
# Changing it makes stored credentials unreadable. Production: ENCRYPTION_KEY_FILE.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# Better Auth: signs session cookies and keys stored sign-in codes. Changing it signs everyone
# out. Production: BETTER_AUTH_SECRET_FILE. Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Proxies allowed to report the client address (x-forwarded-for), comma-separated addresses or
# CIDR ranges. Sign-in rate limits key on it. Required in production: Traefik's network.
# TRUSTED_PROXIES=

# Email through Resend; required in production (RESEND_API_KEY_FILE). Unset, every message is
# written to EMAIL_OUTBOX_DIR instead, where sign-in codes can be read in development.
# RESEND_API_KEY=
EMAIL_FROM=HashiFi <no-reply@hashikome.com>
EMAIL_OUTBOX_DIR=.local/outbox

# CORS origin for the admin web, and this API's public base URL.
FRONTEND_ORIGIN=http://localhost:4000
APP_URL=http://localhost:8080

# RouterOS API
MIKROTIK_API_PORT=8728
MIKROTIK_CONNECT_TIMEOUT=10

# How routers reach this API (the management URL): an IPv4 URL, the API's address inside the
# router tunnel in production. Unset, the local interface on the router's subnet is used.
# ROUTER_MANAGEMENT_URL=http://192.168.0.15:8080

# The origin guests' browsers load the captive portal from, usually a public HTTPS host name.
# Unset, guests are sent to the management URL.
# PORTAL_ORIGIN=https://portal.example.com

# Sentry (optional; telemetry is off without it). Production: SENTRY_DSN_FILE.
# SENTRY_DSN=
