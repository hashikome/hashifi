{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "allowJs": true,
    // Bun runs the API and its tests; "bun" types cover Bun's globals and the `bun:test` module.
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "*.ts"]
}
