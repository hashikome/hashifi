// HashiFi's data model on PostgreSQL 18. Ported from the earlier Drizzle/MySQL schema in the
// build plan's M3; differences are deliberate and listed in that plan.
//
// Conventions: UUIDv7 keys generated by the database; timestamps are timestamptz in UTC (business
// days are computed in Africa/Dar_es_Salaam at query time); money is DECIMAL in TSH; snake_case
// tables and columns. Constraints Prisma cannot express (CHECKs) are in the baseline migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  admin
  manager

  @@map("admin_role")
}

enum AccountStatus {
  active
  inactive
  suspended

  @@map("account_status")
}

enum VenueStatus {
  active
  inactive
  maintenance

  @@map("venue_status")
}

enum RouterStatus {
  online
  offline
  provisioning
  error

  @@map("router_status")
}

enum PackageType {
  hotspot
  home
  business
  premium

  @@map("package_type")
}

/// `pending_activation`: redeemed, but the router has not yet confirmed the hotspot user.
/// Nothing treats it as usable until the router read-back succeeds.
enum VoucherStatus {
  unused
  pending_activation
  active
  expired
  used
  revoked

  @@map("voucher_status")
}

enum DeviceStatus {
  active
  blocked

  @@map("device_status")
}

enum SessionStatus {
  connected
  disconnected
  expired
  terminated

  @@map("session_status")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  cancelled

  @@map("payment_status")
}

/// Provider-neutral: the mobile-money gateway, not the brand, is recorded.
enum PaymentProvider {
  cash
  mobile_money
  card
  manual

  @@map("payment_provider")
}

enum SmsStatus {
  sending
  sent
  delivered
  failed
  unconfirmed

  @@map("sms_status")
}

enum ThemePreference {
  light
  dark
  system

  @@map("theme_preference")
}

// ── Authentication: Better Auth's tables (ADR-0007) ─────────────────────────
// Model names are the ones Better Auth's Prisma adapter expects; only tables and columns are
// renamed. Ids are UUIDv7, generated by the application (advanced.database.generateId).
// HashiFi reads nothing here for authorization: that is `staff`.

/// A person who can sign in. Email is lower-case (CHECK).
model User {
  id               String   @id @db.Uuid
  name             String   @db.VarChar(160)
  email            String   @unique @db.VarChar(255)
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions   Session[]
  accounts   Account[]
  twofactors TwoFactor[]
  staff      Staff?
  codeBudget SignInCodeBudget?

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Sign-in methods. Passwordless: no row ever holds a password (ADR-0007).
model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// One-time sign-in codes, stored hashed.
model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Authenticator-app (TOTP) secrets and backup codes. Required for admins.
model TwoFactor {
  id                      String    @id @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @unique @map("user_id") @db.Uuid
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("two_factors")
}

/// Sign-in rate-limit counters, shared by every API process.
model RateLimit {
  id          String @id @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

/// How many sign-in codes were sent to one person in the current window, whatever address
/// asked: the per-address limit Better Auth's per-IP limits cannot give.
model SignInCodeBudget {
  userId          String   @id @map("user_id") @db.Uuid
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  codesSent       Int      @map("codes_sent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sign_in_code_budgets")
}

// ── Authorization ───────────────────────────────────────────────────────────

/// What HashiFi lets a person do: an admin, or a manager of the venues they operate. Shares
/// the user's id; authorization is read only from here (ADR-0007). No organizations: staff
/// belong to HashiFi itself.
model Staff {
  id          String        @id @db.Uuid
  role        AdminRole     @default(manager)
  status      AccountStatus @default(active)
  phone       String?       @db.VarChar(32)
  lastLoginAt DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User             @relation(fields: [id], references: [id], onDelete: Cascade)
  preference       StaffPreference?
  venues           Venue[]
  voucherBatches   VoucherBatch[]
  auditLogs        AuditLog[]
  recordedPayments Payment[]

  @@index([role])
  @@map("staff")
}

model StaffPreference {
  staffId            String          @id @map("staff_id") @db.Uuid
  theme              ThemePreference @default(system)
  emailNotifications Boolean         @default(true) @map("email_notifications")
  pushNotifications  Boolean         @default(true) @map("push_notifications")
  sessionAlerts      Boolean         @default(true) @map("session_alerts")
  securityAlerts     Boolean         @default(true) @map("security_alerts")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_preferences")
}

model Venue {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operatorId   String?     @map("operator_id") @db.Uuid
  name         String      @db.VarChar(180)
  description  String?
  address      String?     @db.VarChar(255)
  road         String?     @db.VarChar(120)
  street       String?     @db.VarChar(120)
  ward         String?     @db.VarChar(120)
  district     String?     @db.VarChar(120)
  city         String      @db.VarChar(120)
  region       String?     @db.VarChar(120)
  country      String      @default("Tanzania") @db.VarChar(120)
  postalCode   String?     @map("postal_code") @db.VarChar(30)
  contactPhone String?     @map("contact_phone") @db.VarChar(32)
  contactEmail String?     @map("contact_email") @db.VarChar(255)
  latitude     Decimal?    @db.Decimal(10, 7)
  longitude    Decimal?    @db.Decimal(10, 7)
  status       VenueStatus @default(active)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator       Staff?           @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  routers        Router[]
  packages       VenuePackage[]
  brand          VenueBrand?
  voucherBatches VoucherBatch[]
  vouchers       Voucher[]
  payments       Payment[]
  sessions       WifiSession[]
  dailyStats     DailyUsageStat[]

  @@index([operatorId])
  @@index([city])
  @@index([status])
  @@map("venues")
}

model Router {
  id                        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId                   String       @map("venue_id") @db.Uuid
  name                      String       @db.VarChar(160)
  model                     String?      @db.VarChar(160)
  identity                  String?      @db.VarChar(160)
  /// The router's address on its venue LAN, which the bootstrap assigns.
  ipAddress                 String       @map("ip_address") @db.VarChar(45)
  hotspotGatewayIp          String?      @map("hotspot_gateway_ip") @db.VarChar(45)
  macAddress                String?      @unique @map("mac_address") @db.VarChar(32)
  apiUsername               String?      @map("api_username") @db.VarChar(120)
  apiPasswordEncrypted      String?      @map("api_password_encrypted")
  enableHotspot             Boolean      @default(true) @map("enable_hotspot")
  hotspotName               String?      @map("hotspot_name") @db.VarChar(160)
  hotspotInterface          String?      @map("hotspot_interface") @db.VarChar(80)
  /// Network name customers see. Null leaves whatever the radio already broadcasts.
  ssid                      String?      @db.VarChar(32)
  networkRange              String?      @map("network_range") @db.VarChar(64)
  provisioningCommand       String?      @map("provisioning_command")
  provisionedAt             DateTime?    @map("provisioned_at") @db.Timestamptz(3)
  /// The router's address inside the management tunnel (ADR-0006), and so its management
  /// target. Null for a router the API reaches on its LAN.
  tunnelAddress             String?      @unique @map("tunnel_address") @db.VarChar(45)
  tunnelPublicKey           String?      @unique @map("tunnel_public_key") @db.VarChar(64)
  /// Kept so the bootstrap script can be regenerated without orphaning the pasted key.
  tunnelPrivateKeyEncrypted String?      @map("tunnel_private_key_encrypted")
  /// Cached capability probe (services/router-provision/probe.ts).
  rosVersion                String?      @map("ros_version") @db.VarChar(32)
  architecture              String?      @db.VarChar(32)
  capabilities              Json?
  lastProvisionReport       Json?        @map("last_provision_report")
  /// Set while a setup runs; a run this old with no finish was interrupted by a restart.
  setupStartedAt            DateTime?    @map("setup_started_at") @db.Timestamptz(3)
  setupPhase                String?      @map("setup_phase") @db.VarChar(20)
  /// The last finished setup: its phases and what blocked it.
  lastSetup                 Json?        @map("last_setup")
  lastSetupAt               DateTime?    @map("last_setup_at") @db.Timestamptz(3)
  lastSeenAt                DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  uptimeSeconds             Int          @default(0) @map("uptime_seconds")
  connectedDevices          Int          @default(0) @map("connected_devices")
  status                    RouterStatus @default(offline)
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  venue    Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessions WifiSession[]
  payments Payment[]

  @@index([venueId])
  @@index([status])
  @@index([ipAddress])
  @@map("routers")
}

model Package {
  id                    String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                  String      @db.VarChar(180)
  packageType           PackageType @default(hotspot) @map("package_type")
  description           String?
  /// Whole minutes.
  durationMinutes       Int         @map("duration_minutes")
  downloadSpeedMbps     Int         @map("download_speed_mbps")
  uploadSpeedMbps       Int?        @map("upload_speed_mbps")
  dataLimitGb           Int?        @map("data_limit_gb")
  deviceLimit           Int         @default(1) @map("device_limit")
  priceTsh              Decimal     @map("price_tsh") @db.Decimal(12, 2)
  features              String[]    @default([])
  isActive              Boolean     @default(true) @map("is_active")
  throttledDownloadMbps Int?        @map("throttled_download_mbps")
  throttledUploadMbps   Int?        @map("throttled_upload_mbps")
  peakStartHour         Int?        @map("peak_start_hour")
  peakEndHour           Int?        @map("peak_end_hour")
  throttleAfterGb       Int?        @map("throttle_after_gb")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  venues         VenuePackage[]
  voucherBatches VoucherBatch[]
  vouchers       Voucher[]
  payments       Payment[]
  sessions       WifiSession[]
  dailyStats     DailyUsageStat[]

  @@index([packageType])
  @@index([isActive])
  @@index([priceTsh])
  @@map("packages")
}

/// Which packages a venue sells.
model VenuePackage {
  venueId   String   @map("venue_id") @db.Uuid
  packageId String   @map("package_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([venueId, packageId])
  @@index([packageId])
  @@map("venue_packages")
}

/// A guest device as the network saw it: one MAC address, created when a voucher is redeemed.
/// Not a person: one guest can be several devices, and a phone that randomises its MAC can be
/// a new device at each venue. The paying person is a customer (build plan M6).
model Device {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  macAddress    String       @unique @map("mac_address") @db.VarChar(32)
  lastIpAddress String?      @map("last_ip_address") @db.VarChar(45)
  deviceName    String?      @map("device_name") @db.VarChar(160)
  deviceType    String?      @map("device_type") @db.VarChar(40)
  status        DeviceStatus @default(active)
  firstSeenAt   DateTime     @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastActiveAt  DateTime?    @map("last_active_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  redeemedVouchers Voucher[]
  vouchers         VoucherDevice[]
  payments         Payment[]
  sessions         WifiSession[]

  @@index([status])
  @@map("devices")
}

model VoucherBatch {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  packageId   String?   @map("package_id") @db.Uuid
  venueId     String?   @map("venue_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  quantity    Int
  /// Upper-case (CHECK), as voucher codes are.
  prefix      String    @default("WIFI") @db.VarChar(24)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  package   Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  venue     Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdBy Staff?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  vouchers  Voucher[]

  @@index([packageId])
  @@index([venueId])
  @@index([createdById])
  @@map("voucher_batches")
}

model Voucher {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  batchId            String?       @map("batch_id") @db.Uuid
  packageId          String?       @map("package_id") @db.Uuid
  venueId            String?       @map("venue_id") @db.Uuid
  /// The device that redeemed it.
  redeemedByDeviceId String?       @map("redeemed_by_device_id") @db.Uuid
  /// The hotspot username and password. Upper-case (CHECK): RouterOS compares it
  /// case-sensitively, so guest input is upper-cased before lookup and login.
  code               String        @unique @db.VarChar(80)
  status             VoucherStatus @default(unused)
  dataLimitGb        Int?          @map("data_limit_gb")
  dataUsedBytes      BigInt        @default(0) @map("data_used_bytes")
  /// Whole minutes; null inherits the package's.
  durationMinutes    Int?          @map("duration_minutes")
  priceTsh           Decimal       @map("price_tsh") @db.Decimal(12, 2)
  activatedAt        DateTime?     @map("activated_at") @db.Timestamptz(3)
  expiresAt          DateTime?     @map("expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch            VoucherBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  package          Package?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  venue            Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull)
  redeemedByDevice Device?         @relation(fields: [redeemedByDeviceId], references: [id], onDelete: SetNull)
  devices          VoucherDevice[]
  payments         Payment[]
  sessions         WifiSession[]

  @@index([status])
  @@index([packageId])
  @@index([venueId])
  @@index([redeemedByDeviceId])
  @@map("vouchers")
}

/// The devices a voucher has been redeemed on, which its package's device limit counts. Written
/// under a lock on the voucher, so two devices at once cannot both take the last place.
model VoucherDevice {
  voucherId String   @map("voucher_id") @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([voucherId, deviceId])
  @@index([deviceId])
  @@map("voucher_devices")
}

model Payment {
  id                  String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The device that paid, when the payment was made on the portal. The paying person is the
  /// customer.
  deviceId            String?         @map("device_id") @db.Uuid
  voucherId           String?         @map("voucher_id") @db.Uuid
  packageId           String?         @map("package_id") @db.Uuid
  venueId             String?         @map("venue_id") @db.Uuid
  provider            PaymentProvider @default(manual)
  providerReference   String?         @map("provider_reference") @db.VarChar(160)
  phone               String?         @db.VarChar(32)
  amountTsh           Decimal         @map("amount_tsh") @db.Decimal(12, 2)
  status              PaymentStatus   @default(pending)
  paidAt              DateTime?       @map("paid_at") @db.Timestamptz(3)
  /// Tracked separately from `status`: money can be captured while the hotspot user still
  /// does not exist. Access waits on this, not on `status = paid`.
  routerProvisionedAt DateTime?       @map("router_provisioned_at") @db.Timestamptz(3)
  provisionError      String?         @map("provision_error")
  /// The paying device's portal session: only the hash, so the database cannot show a code.
  sessionSecretHash   String?         @map("session_secret_hash") @db.VarChar(64)
  idempotencyKey      String?         @unique @map("idempotency_key") @db.VarChar(30)
  customerId          String?         @map("customer_id") @db.Uuid
  routerId            String?         @map("router_id") @db.Uuid
  macAddress          String?         @map("mac_address") @db.VarChar(32)
  ipAddress           String?         @map("ip_address") @db.VarChar(45)
  /// Where the guest was going, for after they are online.
  destination         String?
  recordedById        String?         @map("recorded_by_id") @db.Uuid
  /// When the provider stops waiting for the guest to approve.
  expiresAt           DateTime?       @map("expires_at") @db.Timestamptz(3)
  lastCheckedAt       DateTime?       @map("last_checked_at") @db.Timestamptz(3)
  /// When the router reported the paying device online.
  signedInAt          DateTime?       @map("signed_in_at") @db.Timestamptz(3)
  metadata            Json?
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  voucher    Voucher?    @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  package    Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  venue      Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  router     Router?     @relation(fields: [routerId], references: [id], onDelete: SetNull)
  recordedBy Staff?      @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  sms        SmsMessage?

  @@index([deviceId])
  @@index([voucherId])
  @@index([status])
  @@index([providerReference])
  @@index([customerId])
  @@map("payments")
}

/// Who pays: a mobile number, the only personal data, shown to admins and to managers for
/// their venues. A guest's device is a `Device`, and one customer can be several.
model Customer {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// E.164, as `+255...`.
  phone     String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments Payment[]

  @@map("customers")
}

/// A provider's event, once. The row is written in the transaction that acts on the event, so
/// a repeat or a race does nothing.
model WebhookEvent {
  provider   String   @db.VarChar(20)
  eventId    String   @map("event_id") @db.VarChar(120)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@id([provider, eventId])
  @@map("webhook_events")
}

/// A code sent to a phone. The text is not kept: it holds the code.
model SmsMessage {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId     String    @unique @map("payment_id") @db.Uuid
  status        SmsStatus @default(sending)
  jobId         String?   @map("job_id") @db.VarChar(120)
  messageId     String?   @map("message_id") @db.VarChar(120)
  failureReason String?   @map("failure_reason") @db.VarChar(255)
  /// Past this without a report, the screen says it was not confirmed.
  confirmBy     DateTime  @map("confirm_by") @db.Timestamptz(3)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([messageId])
  @@index([status])
  @@map("sms_messages")
}

model WifiSession {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId          String?       @map("device_id") @db.Uuid
  voucherId         String?       @map("voucher_id") @db.Uuid
  packageId         String?       @map("package_id") @db.Uuid
  venueId           String?       @map("venue_id") @db.Uuid
  routerId          String?       @map("router_id") @db.Uuid
  macAddress        String        @map("mac_address") @db.VarChar(32)
  ipAddress         String?       @map("ip_address") @db.VarChar(45)
  deviceName        String?       @map("device_name") @db.VarChar(160)
  deviceType        String?       @map("device_type") @db.VarChar(40)
  startedAt         DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime?     @map("ended_at") @db.Timestamptz(3)
  durationSeconds   Int           @default(0) @map("duration_seconds")
  uploadBytes       BigInt        @default(0) @map("upload_bytes")
  downloadBytes     BigInt        @default(0) @map("download_bytes")
  uploadSpeedMbps   Decimal?      @map("upload_speed_mbps") @db.Decimal(8, 2)
  downloadSpeedMbps Decimal?      @map("download_speed_mbps") @db.Decimal(8, 2)
  signalStrengthDbm Int?          @map("signal_strength_dbm")
  terminationReason String?       @map("termination_reason") @db.VarChar(120)
  isThrottled       Boolean       @default(false) @map("is_throttled")
  status            SessionStatus @default(connected)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  device  Device?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  voucher Voucher?             @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  package Package?             @relation(fields: [packageId], references: [id], onDelete: SetNull)
  venue   Venue?               @relation(fields: [venueId], references: [id], onDelete: SetNull)
  router  Router?              @relation(fields: [routerId], references: [id], onDelete: SetNull)
  samples SessionUsageSample[]

  @@index([deviceId])
  @@index([voucherId])
  @@index([routerId])
  @@index([status])
  @@index([startedAt])
  @@index([macAddress])
  @@map("wifi_sessions")
}

model SessionUsageSample {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  sampledAt         DateTime @default(now()) @map("sampled_at") @db.Timestamptz(3)
  uploadBytes       BigInt   @default(0) @map("upload_bytes")
  downloadBytes     BigInt   @default(0) @map("download_bytes")
  uploadSpeedMbps   Decimal? @map("upload_speed_mbps") @db.Decimal(8, 2)
  downloadSpeedMbps Decimal? @map("download_speed_mbps") @db.Decimal(8, 2)
  signalStrengthDbm Int?     @map("signal_strength_dbm")

  session WifiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sampledAt])
  @@map("session_usage_samples")
}

/// The captive portal's wording, colours and voucher defaults: one row (`singleton`, true by
/// CHECK), so saving is an upsert. No images: HashiFi's logo ships with the web.
model PortalSetting {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singleton       Boolean  @unique @default(true)
  brandName       String   @map("brand_name") @db.VarChar(160)
  headline        String   @db.VarChar(180)
  message         String
  primaryColor    String   @map("primary_color") @db.VarChar(16)
  accentColor     String   @map("accent_color") @db.VarChar(16)
  backgroundColor String   @map("background_color") @db.VarChar(16)
  radius          Int      @default(18)
  voucherLabel    String   @map("voucher_label") @db.VarChar(100)
  /// Upper-case (CHECK), as voucher codes are.
  voucherPrefix   String   @default("WIFI") @map("voucher_prefix") @db.VarChar(24)
  voucherHelp     String   @map("voucher_help")
  ticketTitle     String   @map("ticket_title") @db.VarChar(160)
  ticketFooter    String   @map("ticket_footer") @db.VarChar(255)
  requireTerms    Boolean  @default(true) @map("require_terms")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("portal_settings")
}

/// A venue's own branding. No row means the HashiFi default (`portal_settings`).
model VenueBrand {
  venueId         String   @id @map("venue_id") @db.Uuid
  brandName       String   @map("brand_name") @db.VarChar(160)
  headline        String   @db.VarChar(180)
  message         String
  primaryColor    String   @map("primary_color") @db.VarChar(16)
  accentColor     String   @map("accent_color") @db.VarChar(16)
  backgroundColor String   @map("background_color") @db.VarChar(16)
  radius          Int      @default(18)
  voucherLabel    String   @map("voucher_label") @db.VarChar(100)
  voucherPrefix   String   @map("voucher_prefix") @db.VarChar(12)
  voucherHelp     String   @map("voucher_help")
  ticketTitle     String   @map("ticket_title") @db.VarChar(160)
  ticketFooter    String   @map("ticket_footer") @db.VarChar(255)
  requireTerms    Boolean  @default(true) @map("require_terms")
  /// Keys in the brand store; the files themselves never enter this database.
  logoKey         String?  @map("logo_key") @db.VarChar(120)
  backgroundKey   String?  @map("background_key") @db.VarChar(120)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_brands")
}

model DailyUsageStat {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId          String?  @map("venue_id") @db.Uuid
  packageId        String?  @map("package_id") @db.Uuid
  /// The business day in Africa/Dar_es_Salaam.
  statDate         DateTime @map("stat_date") @db.Date
  sessionsCount    Int      @default(0) @map("sessions_count")
  activeUsersCount Int      @default(0) @map("active_users_count")
  uploadBytes      BigInt   @default(0) @map("upload_bytes")
  downloadBytes    BigInt   @default(0) @map("download_bytes")
  revenueTsh       Decimal  @default(0) @map("revenue_tsh") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  venue   Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([packageId])
  @@index([statDate])
  @@map("daily_usage_stats")
}

model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The staff member who acted; null for the system.
  staffId    String?  @map("staff_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
