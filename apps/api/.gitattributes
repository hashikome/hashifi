# Normalize line endings to LF on checkout
* text=auto eol=lf

# Explicitly declare text files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.env* text eol=lf
*.sh   text eol=lf
*.svg  text eol=lf
*.xml  text eol=lf
*.php  text eol=lf

# Keep binaries untouched
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.pdf   binary
