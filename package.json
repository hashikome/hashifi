{
  "name": "hashifi",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run infra:up && bun run --filter '*' dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "api:dev": "bun run --filter @hashifi/api dev",
    "web:dev": "bun run --filter @hashifi/web dev",
    "db:migrate": "bun run --filter @hashifi/api db:migrate",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tooling/tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "lab": "bun tooling/router-lab.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
