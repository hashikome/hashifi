# Worktree-local implementation context. Keep only the usage contract tracked.
ref/*
!ref/README.md

# Local secrets. Track redacted examples only.
.local/
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Operating-system files.
.DS_Store

# Bun workspace dependencies and generated build output.
node_modules/
.next/
dist/
build/
coverage/
.cache/
*.tsbuildinfo
next-env.d.ts

# Prisma Client is generated from the reviewed backend schema.
apps/api/src/generated/prisma/

# Runtime and application artifacts. Keep only data/README.md tracked.
data/**
!data/README.md

# Portal branding uploads are runtime data; only the directory marker is tracked.
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# Database dumps never enter the repository; they can hold customers' personal data.
*.sql.gz
**/database-backups/
